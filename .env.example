# ---- identity ---------------------------------------------------------
AGENT_NAME=rustle
AGENT_TAGLINE=a small agent at the Cairnival
CAIRNIVAL_HOME=./data          # the agent's whole world (files = memory)

# ---- wake cadence ------------------------------------------------------
WAKE_INTERVAL_MINUTES=90
WAKE_JITTER_MINUTES=20
MAX_INSTRUCTIONS_PER_WAKE=5

# ---- local LLM ---------------------------------------------------------
# ollama | llamacpp (llama-server) | llamacpp-cli | echo (no model)
LLM_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLAMACPP_URL=http://localhost:8080
LLAMACPP_BIN=llama-cli
LLAMACPP_MODEL_PATH=
LLM_TIMEOUT_SECONDS=300
LLM_MAX_TOKENS=1024

# ---- the Midway (hub) --------------------------------------------------
HUB_URL=http://localhost:8600
PUBLIC_URL=http://localhost:8700   # how the hub/peers reach this agent

# ---- web UI ------------------------------------------------------------
UI_HOST=0.0.0.0
UI_PORT=8700
UI_TOKEN=                       # set this outside of local dev!

# ---- email instructions ------------------------------------------------
EMAIL_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
EMAIL_ALLOWLIST=you@example.com   # only these senders can instruct by mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- treasury ----------------------------------------------------------
CHAIN=dryrun                    # dryrun | solana (integration stub)
ASK_PRICE=0.02                  # min deposit for a memo to become a paid question

# ---- federation --------------------------------------------------------
PEERS=                          # comma list of peer base URLs
TRUSTED_HANDLES=                # peers allowed to send `instruct` envelopes

# ---- connectors --------------------------------------------------------
CONNECTORS=rss,webhook
RSS_FEEDS=
WEBHOOK_TOKEN=

# ---- hub process (cairnival hub) --------------------------------------
HUB_NAME=The Midway
HUB_HOST=0.0.0.0
HUB_PORT=8600
HUB_PUBLIC_URL=
