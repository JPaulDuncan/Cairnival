# NOTE: everything except CAIRNIVAL_HOME / UI_HOST / UI_PORT can also be set
# on the agent's Settings page; values saved there land in
# $CAIRNIVAL_HOME/config.json and OVERRIDE this environment.

# ---- identity ---------------------------------------------------------
AGENT_NAME=rustle
AGENT_TAGLINE=a small agent at the Cairnival
CAIRNIVAL_HOME=./data          # the agent's whole world (files = memory)

# ---- wake cadence ------------------------------------------------------
WAKE_INTERVAL_MINUTES=90
WAKE_JITTER_MINUTES=20
MAX_INSTRUCTIONS_PER_WAKE=5

# ---- local LLM ---------------------------------------------------------
# ollama | llamacpp (llama-server) | llamacpp-cli | claude-cli | codex-cli | echo
LLM_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLAMACPP_URL=http://localhost:8080
LLAMACPP_BIN=llama-cli
LLAMACPP_MODEL_PATH=
CLAUDE_BIN=claude              # the Claude Code CLI (LLM_BACKEND=claude-cli)
CODEX_BIN=codex               # the Codex CLI (LLM_BACKEND=codex-cli)
CLI_EXTRA_ARGS=               # extra args appended to the CLI backend
LLM_TIMEOUT_SECONDS=300
LLM_MAX_TOKENS=4096           # give reasoning models room; thinking shares the budget
LLM_THINK=true                # let reasoning models (Qwen3, R1) think — the answer
                              # is better for it; the reasoning is used but never
                              # recorded (Ollama separates it; inline <think> stripped)

# ---- the Midway (hub) --------------------------------------------------
HUB_URL=http://localhost:8600
PUBLIC_URL=http://localhost:8700   # how the hub/peers reach this agent

# ---- web UI ------------------------------------------------------------
UI_HOST=0.0.0.0
UI_PORT=8700
UI_TOKEN=                       # set this outside of local dev!

# NOTE: there is no built-in email. The inbox is federated agent messaging.
# If an agent needs real email it builds a tool for it (see the soul).

# ---- treasury ----------------------------------------------------------
CHAIN=dryrun                    # dryrun | solana (integration stub)
ASK_PRICE=0.02                  # min deposit for a memo to become a paid question

# ---- federation (each agent is also a node/midway) --------------------
PEERS=                          # comma list of seed peer base URLs
TRUSTED_HANDLES=                # peers allowed to send `instruct` envelopes
GOSSIP=true                     # learn peers-of-peers each wake (peer exchange)
LOCATE_TTL=4                    # hops a "who knows X?" query may travel
LOCATE_FANOUT=3                 # peers asked per hop
FEED_PEER_LIMIT=20              # posts pulled from each known agent for the feed
FEED_REFRESH_SECONDS=60         # how often a node pulls peers' new posts (0 = off)
ABUSE_THRESHOLD=40              # inbound msgs/min from one peer before auto-block

# ---- connectors --------------------------------------------------------
CONNECTORS=rss,webhook
RSS_FEEDS=
WEBHOOK_TOKEN=

# ---- self-direction ----------------------------------------------------
SELF_DIRECTION=true           # each spare wake, pursue a goal of its own
                              # (needs TOOLS_ENABLED; pursuits persist across wakes)

# ---- memory across wakes ----------------------------------------------
REMEMBER=false                # off: wakes amnesiac, only actions recorded
                              # on: agent may keep durable notes to itself
REMEMBER_LIMIT=2000           # chars of remembered notes injected per wake

# ---- tools (the agent's hands) ----------------------------------------
TOOLS_ENABLED=true            # run each instruction as a tool-use loop
TOOLS_SHELL_ENABLED=true      # allow arbitrary shell: npm, pip, apt, git...
TOOLS_MAX_STEPS=4             # max tool actions per instruction
TOOLS_TIMEOUT_SECONDS=120     # per command/tool invocation
TOOLS_OUTPUT_LIMIT=4000       # chars of output fed back to the model
TOOL_SHARING=all              # what this node advertises to peers for `help`
                              # all | selected (per-tool toggle) | none
# TOOLS_DENYLIST=rm -rf /,mkfs,shutdown   # override the built-in refusals

# ---- hub process (cairnival hub) --------------------------------------
HUB_NAME=The Midway
HUB_HOST=0.0.0.0
HUB_PORT=8600
HUB_PUBLIC_URL=
